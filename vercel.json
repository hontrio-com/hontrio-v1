{
  "regions": ["dub1"],
  "crons": [
    {
      "path": "/api/cron/commerce-sync",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/cron/ads-sync",
      "schedule": "15 * * * *"
    },
    {
      "path": "/api/cron/retention",
      "schedule": "40 3 * * *"
    }
  ],
  "functions": {
    "app/api/stores/[id]/sync/route.ts": {
      "maxDuration": 300
    },
    "app/api/cron/commerce-sync/route.ts": {
      "maxDuration": 300
    },
    "app/api/integrations/edinio/callback/route.ts": {
      "maxDuration": 300
    },
    "app/api/cron/ads-sync/route.ts": {
      "maxDuration": 300
    },
    "app/api/cron/retention/route.ts": {
      "maxDuration": 300
    }
  }
}
