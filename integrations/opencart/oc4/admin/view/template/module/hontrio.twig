{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="float-end">
        {% if installed %}
        <button type="submit" form="form-module" data-bs-toggle="tooltip" title="{{ button_save }}" class="btn btn-primary"><i class="fa-solid fa-save"></i></button>
        {% endif %}
        <a href="{{ back }}" data-bs-toggle="tooltip" title="{{ button_back }}" class="btn btn-light"><i class="fa-solid fa-reply"></i></a></div>
      <h1>{{ heading_title }}</h1>
      <ol class="breadcrumb">
        {% for breadcrumb in breadcrumbs %}
          <li class="breadcrumb-item"><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
        {% endfor %}
      </ol>
    </div>
  </div>
  <div class="container-fluid">
    {% if not installed %}
    <div class="alert alert-warning"><i class="fa-solid fa-triangle-exclamation"></i> {{ text_not_installed }}</div>
    {% else %}
    <div class="card mb-3">
      <div class="card-header"><i class="fa-solid fa-link"></i> {{ text_steps }}</div>
      <div class="card-body">
        <p>{{ text_intro }}</p>
        <ol>
          <li>{{ text_step_1 }}</li>
          <li>{{ text_step_2 }}</li>
          <li>{{ text_step_3 }}</li>
        </ol>
        <p class="text-muted mb-0">{{ text_reads }}</p>
      </div>
    </div>
    <div class="card">
      <div class="card-header"><i class="fa-solid fa-pencil"></i> {{ text_edit }}</div>
      <div class="card-body">
        <form id="form-module" action="{{ save }}" method="post" data-oc-toggle="ajax">
          <div class="row mb-3">
            <label for="input-store-url" class="col-sm-2 col-form-label">{{ entry_store_url }}</label>
            <div class="col-sm-10">
              <input type="text" id="input-store-url" value="{{ store_url }}" class="form-control" readonly/>
            </div>
          </div>
          <div class="row mb-3">
            <label for="input-key" class="col-sm-2 col-form-label">{{ entry_key }}</label>
            <div class="col-sm-10">
              <div class="input-group">
                <input type="text" id="input-key" value="{{ key }}" class="form-control font-monospace" readonly/>
                <button type="button" id="button-copy" class="btn btn-light"><i class="fa-solid fa-copy"></i> <span id="button-copy-text">{{ button_copy }}</span></button>
              </div>
            </div>
          </div>
          <div class="row mb-3">
            <label class="col-sm-2 col-form-label">{{ entry_status }}</label>
            <div class="col-sm-10">
              <div class="form-check form-switch form-switch-lg">
                <input type="hidden" name="module_hontrio_status" value="0"/>
                <input type="checkbox" name="module_hontrio_status" value="1" id="input-status" class="form-check-input"{% if module_hontrio_status %} checked{% endif %}/>
              </div>
              <div class="form-text">{{ text_status_help }}</div>
            </div>
          </div>
          <div class="row mb-3">
            <label class="col-sm-2 col-form-label">{{ entry_tracking }}</label>
            <div class="col-sm-10">
              <div class="form-check form-switch form-switch-lg">
                <input type="hidden" name="module_hontrio_tracking" value="0"/>
                <input type="checkbox" name="module_hontrio_tracking" value="1" id="input-tracking" class="form-check-input"{% if module_hontrio_tracking %} checked{% endif %}/>
              </div>
              <div class="form-text">{{ text_tracking_help }}</div>
            </div>
          </div>
        </form>
        <div class="row">
          <div class="offset-sm-2 col-sm-10">
            <button type="button" id="button-regenerate" data-action="{{ regenerate }}" class="btn btn-warning"><i class="fa-solid fa-rotate"></i> {{ button_regenerate }}</button>
            <div class="form-text">{{ text_regenerate_help }}</div>
          </div>
        </div>
      </div>
    </div>
    {% endif %}
  </div>
</div>
<script type="text/javascript"><!--
(function () {
  var copy = document.getElementById('button-copy');
  if (copy) {
    copy.addEventListener('click', function () {
      var input = document.getElementById('input-key');
      var done = function () {
        var label = document.getElementById('button-copy-text');
        label.textContent = '{{ text_copied|escape('js') }}';
        setTimeout(function () { label.textContent = '{{ button_copy|escape('js') }}'; }, 2000);
      };
      if (navigator.clipboard && window.isSecureContext) {
        navigator.clipboard.writeText(input.value).then(done);
      } else {
        input.removeAttribute('readonly');
        input.select();
        document.execCommand('copy');
        input.setAttribute('readonly', 'readonly');
        done();
      }
    });
  }

  var regenerate = document.getElementById('button-regenerate');
  if (regenerate) {
    regenerate.addEventListener('click', function () {
      if (!confirm('{{ text_regenerate_confirm|escape('js') }}')) {
        return;
      }
      regenerate.disabled = true;
      fetch(regenerate.getAttribute('data-action'), { method: 'POST', credentials: 'same-origin', headers: { 'X-Requested-With': 'XMLHttpRequest' } })
        .then(function (response) { return response.json(); })
        .then(function (json) {
          var alert = document.getElementById('alert');
          var text = json.error || json.success || '';
          if (json.key) {
            document.getElementById('input-key').value = json.key;
          }
          if (alert && text) {
            var box = document.createElement('div');
            box.className = 'alert alert-' + (json.error ? 'danger' : 'success') + ' alert-dismissible';
            box.textContent = text;
            var close = document.createElement('button');
            close.type = 'button';
            close.className = 'btn-close';
            close.setAttribute('data-bs-dismiss', 'alert');
            box.appendChild(close);
            alert.prepend(box);
          }
        })
        .finally(function () { regenerate.disabled = false; });
    });
  }
})();
//--></script>
{{ footer }}
